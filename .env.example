# Copia este archivo como .env y completa los valores reales:
#   cp .env.example .env

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL
DB_NAME=etabaco_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432

# Mercado Pago (credenciales de https://www.mercadopago.cl/developers -> tu app -> Credenciales)
# Usa las de PRUEBA (empiezan con TEST-) mientras desarrollas.
MP_ACCESS_TOKEN=TEST-...
MP_PUBLIC_KEY=TEST-...
MP_CURRENCY=CLP

# URL pública del sitio (para back_urls y el webhook de Mercado Pago).
# En local usa el túnel de ngrok, ej: https://abcd-1234.ngrok-free.app
SITE_URL=http://localhost:8000

# Email (en DEBUG=True se imprime en consola y no se envía nada)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password
DEFAULT_FROM_EMAIL=Puro Tabaco <noreply@purotabaco.cl>
CONTACT_EMAIL=contacto@purotabaco.cl
# Correo del negocio que recibe aviso de cada venta
VENTAS_NOTIFY_EMAIL=purotabacochile@gmail.com

# Empresa (datos que se muestran en el sitio)
EMPRESA_TELEFONO=+56 9 1234 5678
EMPRESA_TELEFONO_WSP=56912345678
EMPRESA_EMAIL=contacto@purotabaco.cl
ENVIO_GRATIS_DESDE=50000

# Gate de edad (cookie firmada)
AGE_MINIMUM=18
AGE_VERIFICATION_COOKIE_MAX_AGE=2592000  # 30 días en segundos

# Cifras del home (dejar vacío hasta que el cliente las confirme —
# si están vacías, el bloque de estadísticas NO se muestra)
EMPRESA_ANIO_FUNDACION=
EMPRESA_ANIOS_HERENCIA=
EMPRESA_N_MARCAS=
EMPRESA_DESPACHO_HORAS=
